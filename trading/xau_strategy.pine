//@version=6
strategy("XAUUSD Clean Scalper + Liquidity Sweeps",overlay=true)
rsiLength=input.int(14)
emaFastLength=input.int(9)
emaSlowLength=input.int(21)
atrLength=input.int(14)
rsi=ta.rsi(close,rsiLength)
emaFast=ta.ema(close,emaFastLength)
emaSlow=ta.ema(close,emaSlowLength)
atr=ta.atr(atrLength)
bullTrend=emaFast>emaSlow
bearTrend=emaFast<emaSlow
volOk=atr>ta.sma(atr,50)
longCondition=bullTrend and rsi<40 and volOk
shortCondition=bearTrend and rsi>60 and volOk
if longCondition
    strategy.entry("LONG",strategy.long)
if shortCondition
    strategy.entry("SHORT",strategy.short)
if bearTrend or rsi>55
    strategy.close("LONG")
if bullTrend or rsi<45
    strategy.close("SHORT")
gold=color.rgb(212,175,55)
black=color.rgb(0,0,0)
plot(emaFast,color=gold,linewidth=2)
plot(emaSlow,color=black,linewidth=2)
newDay=ta.change(time("D"))!=0
var float dayHigh=na
var float dayLow=na
var line highLine=na
var line lowLine=na
if newDay
    if not na(highLine)
        line.delete(highLine)
    if not na(lowLine)
        line.delete(lowLine)
    dayHigh=high
    dayLow=low
    highLine=line.new(bar_index,dayHigh,bar_index+1,dayHigh,extend=extend.right,color=color.yellow,width=2)
    lowLine=line.new(bar_index,dayLow,bar_index+1,dayLow,extend=extend.right,color=color.black,width=2)
else
    dayHigh=math.max(dayHigh,high)
    dayLow=math.min(dayLow,low)
    line.set_y1(highLine,dayHigh)
    line.set_y2(highLine,dayHigh)
    line.set_y1(lowLine,dayLow)
    line.set_y2(lowLine,dayLow)
sweepHigh=high>dayHigh and close<dayHigh
sweepLow=low<dayLow and close>dayLow
plotshape(sweepHigh,location=location.abovebar,color=color.red,style=shape.labeldown,text="SWEEP")
plotshape(sweepLow,location=location.belowbar,color=color.lime,style=shape.labelup,text="SWEEP")